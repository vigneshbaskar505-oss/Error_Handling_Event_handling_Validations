package exceptionExpo;

public class ExceptionHandlingDemo2  {
	
	
	public void throwsDemo() throws Exception {
		String s=null;
		System.out.println(s.length());
//		critical statement to find length for empty statement
	}
	
	public void slave() {
		try {
			throwsDemo();
		}
		catch(Exception e) {
			System.out.println("Error occured here is "+e);
		}
	}

	public static void main(String[] args) throws Exception   {
 
		ExceptionHandlingDemo2 obj=new ExceptionHandlingDemo2();
		obj.slave();
 		
	}


}


